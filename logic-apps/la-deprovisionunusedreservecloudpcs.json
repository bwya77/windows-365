"tier": "community",
"armtemplate": "Generated from https://github.com/Azure/Azure-Sentinel/tree/master/Tools/Playbook-ARM-Template-Generator"
},
"author": {
"name": ""
}
},
"parameters": {
"PlaybookName": {
"defaultValue": "la-unusedreservecloudpcs",
"type": "string"
}
},
"variables": {
"Azureautomation-1ConnectionName": "[concat('Azureautomation-1-', parameters('PlaybookName'))]",
"Office365-1ConnectionName": "[concat('Office365-1-', parameters('PlaybookName'))]"
},
"resources": [
{
"properties": {
    "provisioningState": "Succeeded",
    "state": "Enabled",
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "parameters": {
            "$connections": {
            "defaultValue": {},
            "type": "Object"
        }
    },
    "triggers": {
        "Recurrence_-_Every_12hr": {
            "recurrence": {
                "interval": 12,
                "frequency": "Hour",
                "timeZone": "Central Standard Time",
                "startTime": "2026-08-27T17:00:00Z"
            },
            "evaluatedRecurrence": {
                "interval": 12,
                "frequency": "Hour",
                "timeZone": "Central Standard Time",
                "startTime": "2026-08-27T17:00:00Z"
            },
            "type": "Recurrence"
        }
    },
    "actions": {
        "Create_job_-_Run_Runbook": {
        "runAfter": {},
        "type": "ApiConnection",
        "inputs": {
            "host": {
                "connection": {
                    "name": "@parameters('$connections')['azureautomation-1']['connectionId']"
                }
            },
            "method": "put",
            "body": {
                "properties": {
                    "parameters": {
                        "ReservePolicyDisplayName": "W365-Reserve",
                        "MinProvisionedHours": 0,
                        "MinIdleHours": 0
                    }
                }
            },
            "path": "/subscriptions/@{encodeURIComponent('4719028c-6dc1-4647-8b2b-8f2db2969037')}/resourceGroups/@{encodeURIComponent('rg-w365-automation')}/providers/Microsoft.Automation/automationAccounts/@{encodeURIComponent('aa-unusedreservecloudpc')}/jobs",
            "queries": {
                "x-ms-api-version": "2015-10-31",
                "runbookName": "unused-reserve-cloud-pcs",
                "wait": true
            }
        }
    },
    "Get_job_output": {
        "runAfter": {
            "Create_job_-_Run_Runbook": [
                "Succeeded"
            ]
        },
        "type": "ApiConnection",
        "inputs": {
            "host": {
                "connection": {
                    "name": "@parameters('$connections')['azureautomation-1']['connectionId']"
                }
            },
            "method": "get",
            "path": "/subscriptions/@{encodeURIComponent('4719028c-6dc1-4647-8b2b-8f2db2969037')}/resourceGroups/@{encodeURIComponent('rg-w365-automation')}/providers/Microsoft.Automation/automationAccounts/@{encodeURIComponent('aa-unusedreservecloudpc')}/jobs/@{encodeURIComponent(body('Create_job_-_Run_Runbook')?['properties']?['jobId'])}/output",
            "queries": {
                "x-ms-api-version": "2015-10-31"
            }
        }
    },
    "Parse_JSON_Results": {
        "runAfter": {
            "Get_job_output": [
                "Succeeded"
            ]
        },
        "type": "ParseJson",
        "inputs": {
            "content": "@body('Get_job_output')",
            "schema": {
                "type": "object",
                "properties": {
                    "generatedUtc": {
                        "type": "string"
                    },
                    "thresholdHours": {
                        "type": "object",
                        "properties": {
                            "minProvisionedHours": {
                                "type": "integer"
                            },
                            "minIdleHours": {
                                "type": "integer"
                            }
                        }
                    },
                    "reservePolicies": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string"
                                },
                                "displayName": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "totalCloudPcs": {
                        "type": "integer"
                    },
                    "idleCount": {
                        "type": "integer"
                    },
                    "idleCloudPcs": {
                        "type": "array"
                    },
                    "emailBodyHtml": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "Are_there_1_or_more_reserve_PCs_that_can_be_deprovisioned": {
        "actions": {
            "For_each_idle_Cloud_PC": {
                "foreach": "@body('Parse_JSON_Results')?['idleCloudPcs']",
                "actions": {
                    "Send_approval_email_for_this_Cloud_PC": {
                        "type": "ApiConnectionWebhook",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "name": "@parameters('$connections')['office365-1']['connectionId']"
                                }
                            },
                            "body": {
                                "NotificationUrl": "@listCallbackUrl()",
                                "Message": {
                                    "To": "brad@windowsfromanywhere.com",
                                    "Body": "<p>The following Windows 365 Reserve Cloud PC has been idle and is a candidate for deprovisioning:</p><table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse;font-family:Segoe UI,Arial,sans-serif;font-size:13px;\"><tr><td><b>Device Name</b></td><td>@{items('For_each_idle_Cloud_PC')?['managedDeviceName']}</td></tr><tr><td><b>Assigned User</b></td><td>@{items('For_each_idle_Cloud_PC')?['assignedUserPrincipalName']}</td></tr><tr><td><b>Reserve Policy</b></td><td>@{items('For_each_idle_Cloud_PC')?['reservePolicyName']}</td></tr><tr><td><b>Provisioned (UTC)</b></td><td>@{items('For_each_idle_Cloud_PC')?['provisionedDateTimeUtc']}</td></tr><tr><td><b>Last Sign-In (UTC)</b></td><td>@{if(items('For_each_idle_Cloud_PC')?['neverSignedIn'], 'Never signed in', items('For_each_idle_Cloud_PC')?['lastActiveTimeUtc'])}</td></tr></table><p>Approve to deprovision this specific Cloud PC now, or reject to leave it as-is.</p>",
                                    "Importance": "Normal",
                                    "UseOnlyHTMLMessage": true,
                                    "Subject": "Approval Request: deprovision idle Windows 365 Reserve Cloud PC @{items('For_each_idle_Cloud_PC')?['managedDeviceName']}",
                                    "Options": "Approve, Reject"
                                }
                            },
                            "path": "/approvalmail/$subscriptions"
                        }
                    },
                    "Is_this_Cloud_PC_approved": {
                        "actions": {
                            "Create_job_-_Deprovision_Cloud_PC": {
                                "type": "ApiConnection",
                                "inputs": {
                                    "host": {
                                        "connection": {
                                            "name": "@parameters('$connections')['azureautomation-1']['connectionId']"
                                        }
                                    },
                                    "method": "put",
                                    "body": {
                                        "properties": {
                                            "parameters": {
                                                "CloudPcId": "@{items('For_each_idle_Cloud_PC')?['cloudPcId']}",
                                                "ManagedDeviceName": "@{items('For_each_idle_Cloud_PC')?['managedDeviceName']}"
                                            }
                                        }
                                    },
                                    "path": "/subscriptions/@{encodeURIComponent('4719028c-6dc1-4647-8b2b-8f2db2969037')}/resourceGroups/@{encodeURIComponent('rg-w365-automation')}/providers/Microsoft.Automation/automationAccounts/@{encodeURIComponent('aa-unusedreservecloudpc')}/jobs",
                                    "queries": {
                                        "x-ms-api-version": "2015-10-31",
                                        "runbookName": "Invoke-DeprovisionWindows365ReserveCloudPc",
                                        "wait": false
                                    }
                                }
                            }
                        },
                        "runAfter": {
                            "Send_approval_email_for_this_Cloud_PC": [
                                "Succeeded"
                            ]
                        },
                        "else": {
                        "actions": {}
                    },
                    "expression": {
                        "and": [
                            {
                                "equals": [
                                    "@body('Send_approval_email_for_this_Cloud_PC')?['SelectedOption']",
                                    "Approve"
                                ]
                            }
                        ]
                    },
                    "type": "If"
                }
            },
            "type": "Foreach",
            "runtimeConfiguration": {
                "concurrency": {
                    "repetitions": 1
                }
            }
        }
    },
    "runAfter": {
        "Parse_JSON_Results": [
            "Succeeded"
        ]
    },
    "else": {
    "actions": {}
},
"expression": {
    "and": [
        {
            "greater": [
                "@body('Parse_JSON_Results')?['idleCount']",
                0
            ]
        }
    ]
},
"type": "If"
}
},
"outputs": {}
},
