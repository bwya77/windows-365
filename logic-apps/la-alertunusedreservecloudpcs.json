            }
        }
    },
    "Parse_JSON_Results": {
        "runAfter": {
            "Get_job_output": [
                "Succeeded"
            ]
        },
        "type": "ParseJson",
        "inputs": {
            "content": "@body('Get_job_output')",
            "schema": {
                "type": "object",
                "properties": {
                    "generatedUtc": {
                        "type": "string"
                    },
                    "thresholdHours": {
                        "type": "object",
                        "properties": {
                            "minProvisionedHours": {
                                "type": "integer"
                            },
                            "minIdleHours": {
                                "type": "integer"
                            }
                        }
                    },
                    "reservePolicies": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string"
                                },
                                "displayName": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "totalCloudPcs": {
                        "type": "integer"
                    },
                    "idleCount": {
                        "type": "integer"
                    },
                    "idleCloudPcs": {
                        "type": "array"
                    },
                    "emailBodyHtml": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "Are_there_1_or_more_reserve_PCs_that_can_be_deprovisioned": {
        "actions": {
            "Send_an_email_(V2)": {
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('$connections')['office365']['connectionId']"
                        }
                    },
                    "method": "post",
                    "body": {
                        "To": "brad@windowsfromanywhere.com",
                        "Subject": "Windows 365 Reserve idle Cloud PCs (@{body('Parse_JSON_Results')?['idleCount']})",
                        "Body": "@body('Parse_JSON_Results')?['emailBodyHtml']",
                        "Importance": "Normal"
                    },
                    "path": "/v2/Mail"
                }
            }
        },
        "runAfter": {
            "Parse_JSON_Results": [
                "Succeeded"
            ]
        },
        "else": {
        "actions": {}
    },
    "expression": {
        "and": [
            {
                "greater": [
                    "@body('Parse_JSON_Results')?['idleCount']",
                    0
                ]
            }
        ]
    },
    "type": "If"
}
},
